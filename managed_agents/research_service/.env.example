# Required: your Anthropic API key with Managed Agents beta access
ANTHROPIC_API_KEY=

# Optional: abort any run whose cumulative cost crosses this (USD)
RESEARCH_BUDGET_USD=10.0

# Optional: where run state persists (default .runs)
RESEARCH_RUN_DIR=.runs

# Optional: override the models configured in config/team.yaml
# COOKBOOK_COORDINATOR_MODEL=claude-fable-5
# COOKBOOK_WORKER_MODEL=claude-sonnet-5
